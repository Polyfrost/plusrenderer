    "nameplate",
    "nameplate_reactions",
    "nameplate_one_shots",
    "nameplate_schedules"
  ],
  "fps": 8,
  "loop": 16,
  "layers": [
    {
      "id": "body"
    },
    {
      "id": "lamp",
      "step": 2
